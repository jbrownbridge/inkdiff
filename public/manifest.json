{
  "manifest_version": 3,
  "name": "Inkdiff",
  "version": "1.0.0",
  "description": "Review rendered Markdown and diagrams in pull requests, and comment on the exact source lines.",
  "homepage_url": "https://github.com/jbrownbridge/inkdiff",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "120",
  "host_permissions": [
    "https://github.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mermaid/*"
      ],
      "matches": [
        "https://github.com/*"
      ],
      "use_dynamic_url": false
    }
  ],
  "options_page": "options.html"
}
